# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/alpaquitay

# JWT Secret (generate a strong one for production)
JWT_SECRET=your-super-secret-key-change-in-production

# Clover API
CLOVER_API_KEY=your-clover-api-key
CLOVER_MERCHANT_ID=your-merchant-id
CLOVER_ENVIRONMENT=sandbox
CLOVER_BASE_URL=https://sandbox.dev.clover.com

# Fiserv API
FISERV_API_KEY=your-fiserv-api-key
FISERV_API_SECRET=your-fiserv-api-secret
FISERV_MERCHANT_ID=your-fiserv-merchant-id
FISERV_ENVIRONMENT=sandbox
FISERV_BASE_URL=https://cert.api.fiservapps.com

# Webhook Secret (for verifying payment callbacks)
WEBHOOK_SECRET=your-webhook-signing-secret

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads
